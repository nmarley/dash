[dashd]
zmq_endpoint = "tcp://127.0.0.1:28332"
rpc_url = "http://127.0.0.1:9998"
rpc_user = "dashuser"
rpc_password = "dashpass"
# Optional: path to dashd datadir for direct block file reading
datadir = "/path/to/.dashcore"

[indexer]
datadir = "./index-data"
# Bootstrap from block files (faster initial sync)
bootstrap_from_files = true
# Which indexes to build
indexes = ["tx", "address", "spent"]

[api]
# gRPC server address
grpc_listen = "127.0.0.1:50051"
# Optional JSON-RPC server (for backward compatibility)
jsonrpc_listen = "127.0.0.1:3000"

[logging]
# Log level: trace, debug, info, warn, error
level = "info"
# Format: json or pretty
format = "pretty"
